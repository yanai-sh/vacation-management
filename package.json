{
  "name": "vacation-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @vacation-management/api db:migrate",
    "db:seed": "pnpm --filter @vacation-management/api db:seed",
    "setup": "node ./scripts/setup.mjs"
  },
  "engines": {
    "node": "^26.0.0"
  }
}
