# PostgreSQL (used by Docker Compose and the API)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vacation
POSTGRES_PASSWORD=vacation
POSTGRES_DB=vacation_management

# API
API_PORT=8888
FRONT_END_URL=http://localhost:5173
ALIAS=local
PARAMETER_STORE_ENABLED=false

# Demo-only JWT signing secret (HS256). Copy to .env as-is for local runs.
JWT_SECRET=dev-only-change-me-vacation-management-32b

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8888
