{
  "name": "@vacation-management/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --env-file=../../.env ./node_modules/ts-node/dist/bin.js src/index.ts --local",
    "build": "cef-build",
    "codegen": "cef-gen-handlers",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "lint:fix": "echo \"No automatic lint fixes configured for api yet\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\"",
    "typeorm": "node --env-file=../../.env ./node_modules/typeorm/cli.js",
    "db:migrate": "node --env-file=../../.env -r ts-node/register ./node_modules/typeorm/cli.js migration:run -d src/persistence/data-source.ts",
    "db:migrate:generate": "node --env-file=../../.env -r ts-node/register ./node_modules/typeorm/cli.js migration:generate src/persistence/migrations/Migration -d src/persistence/data-source.ts",
    "db:migrate:revert": "node --env-file=../../.env -r ts-node/register ./node_modules/typeorm/cli.js migration:revert -d src/persistence/data-source.ts"
  },
  "dependencies": {
    "commoneventframework": "^1.0.19",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^26.0.0"
  }
}
